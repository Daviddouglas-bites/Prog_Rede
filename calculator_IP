def ip_para_bin(ip):
    # Converte IP para binário (ex: 192.168.1.1 → 11000000101010000000000100000001)
    return ''.join(f'{int(octeto):08b}' for octeto in ip.split('.'))

def bin_para_ip(binario):
    # Converte binário para IP normal (ex: 11000000... → 192.168.1.1)
    return '.'.join(str(int(binario[i:i+8], 2)) for i in range(0, 32, 8))

def calcular_subrede(ip, prefixo):
    bin_ip = ip_para_bin(ip)

    # Máscara de sub-rede em binário
    mascara_bin = '1' * prefixo + '0' * (32 - prefixo)

    # Endereço de rede (AND entre IP e máscara)
    rede_bin = ''.join(str(int(bin_ip[i]) & int(mascara_bin[i])) for i in range(32))

    # Endereço de broadcast (OR entre IP e NOT da máscara)
    broadcast_bin = ''.join(str(int(bin_ip[i]) | (1 - int(mascara_bin[i]))) for i in range(32))

    # Conversões para decimal
    rede = bin_para_ip(rede_bin)
    broadcast = bin_para_ip(broadcast_bin)
    mascara_decimal = bin_para_ip(mascara_bin)

    # Primeiro e último host válidos
    ip_primario = bin_para_ip(f'{int(rede_bin, 2) + 1:032b}')
    ip_final = bin_para_ip(f'{int(broadcast_bin, 2) - 1:032b}')

    # Número total de IPs na rede
    total_ips = 2 ** (32 - prefixo)
    hosts_validos = total_ips - 2 if total_ips > 2 else 0

    # Exibição das informações
    print("\n--- Informações da Sub-rede ---")
    print(f"a) Endereço de Rede: {rede}")
    print(f"b) Primeiro Host: {ip_primario}")
    print(f"c) Último Host: {ip_final}")
    print(f"d) Endereço de Broadcast: {broadcast}")
    print(f"e) Máscara de Sub-rede:")
    print(f"- Decimal: {mascara_decimal}")
    print(f"- Binário: {mascara_bin}")
    print(f"f) Número de Hosts Válidos:{hosts_validos}")
    

# Execução
ip = input("Digite o IP (ex: 192.168.1.10): ")
prefixo = int(input("Digite o prefixo (ex: 24): "))
calcular_subrede(ip, prefixo)
